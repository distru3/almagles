generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  visitor
  writer
  admin
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  role              Role               @default(visitor)
  canManageSchedule Boolean            @default(false)
  /// Profile photo in Cloudinary (512px square WebP) and a short bio, set by the user.
  avatarUrl         String?
  avatarPublicId    String?
  bio               String?
  managedCategories Category[]         @relation("CategoryAdmins")
  refreshTokens     RefreshToken[]
  councilNotes      CouncilNote[]
  posts             Post[]
  comments          Comment[]
  reactions         Reaction[]
  commentReactions  CommentReaction[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]     @relation("NotificationRecipient")
  notificationsSent Notification[]     @relation("NotificationActor")
  tasksCreated      Task[]
  taskCompletions   TaskCompletion[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

/// One row per login session. Only the SHA-256 of the cookie value is stored.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  /// Set when this token is exchanged for a new one; it stays usable for a
  /// short grace window so tabs refreshing at the same moment both succeed.
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  order      Int      @default(0)
  adminUsers User[]   @relation("CategoryAdmins")
  posts      Post[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Post {
  id             String         @id @default(cuid())
  title          String
  description    String
  postDate       String
  /// Deprecated: replaced by `images` (PostImage). Kept for one release so the old server keeps
  /// working while a deploy rolls out; nothing reads or writes them any more. Drop next release.
  imagePublicId  String?
  imageUrl       String?
  /// The post's photos, in display order; the first is the cover (feed card, share preview).
  images         PostImage[]
  /// Video stored in Cloudinary (compressed in the browser before upload); only its address lives here.
  videoPublicId  String?
  videoUrl       String?
  videoPosterUrl String?
  videoWidth     Int?
  videoHeight    Int?
  videoDuration  Float?
  /// Previews (title, image, YouTube id) for the links in the description, fetched when the post is saved.
  linkPreviews   Json?
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId     String
  author         User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId       String
  comments       Comment[]
  reactions      Reaction[]
  notifications  Notification[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([postDate])
  @@index([categoryId])
}

/// One photo of a post. Stored in Cloudinary (or server/uploads in local development).
model PostImage {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  publicId  String
  url       String
  width     Int?
  height    Int?
  /// 0 = cover.
  position  Int
  createdAt DateTime @default(now())

  @@index([postId, position])
}

model Comment {
  id            String            @id @default(cuid())
  content       String
  post          Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId        String
  author        User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId      String
  parent        Comment?          @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId      String?
  replies       Comment[]         @relation("Replies")
  notifications Notification[]
  reactions     CommentReaction[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([postId])
}

model Reaction {
  id        String   @id @default(cuid())
  type      String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

/// Same three types as post reactions; one per person per comment (or reply).
model CommentReaction {
  id        String   @id @default(cuid())
  type      String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

model ScheduleItem {
  id              String         @id @default(cuid())
  date            String
  weekdayKey      String
  timeLabel       String
  section         String?
  title           String
  notes           String?
  linkUrl         String?
  /// Text shown for the link (e.g. "درس الشيخ على يوتيوب"); falls back to a generic label.
  linkLabel       String?
  /// Values for admin-defined columns, keyed by ScheduleColumn.id.
  customValues    Json           @default("{}")
  /// Order of sessions within the same day.
  sortOrder       Int            @default(0)
  /// Clock time the session starts ("HH:MM", 24h) for the «حان وقت المجلس» reminder;
  /// timeLabel stays free text («فجر», «بعد العصر») and can't be scheduled on.
  startTime       String?
  /// IANA zone startTime was entered in (the manager's browser), e.g. "Africa/Casablanca".
  timeZone        String?
  /// When the reminder goes out: date + startTime in timeZone. Null = no reminder.
  remindAt        DateTime?
  /// Sent with the reminder: a verse, a hadith or the manager's own words.
  reminderMessage String?
  /// Set once the reminder was sent; cleared when the date or time changes.
  remindedAt      DateTime?
  /// Row id in the old almagles-schedule (Firebase) app; makes the import re-runnable.
  sourceId        String?        @unique
  notifications   Notification[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([date])
  @@index([remindAt])
}

/// «ملاحظات المجلس» — one note per calendar day, readable by everyone and
/// written by admins and writers. An empty note is deleted rather than stored.
model CouncilNote {
  id          String   @id @default(cuid())
  date        String   @unique
  content     String
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Extra columns the schedule managers add to every session (e.g. «الشيخ», «الكمية»).
model ScheduleColumn {
  id        String   @id @default(cuid())
  label     String
  order     Int      @default(0)
  sourceId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  purpose   String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
}

enum NotificationType {
  /// Someone commented on a post you wrote.
  comment
  /// Someone replied to your comment.
  reply
  /// Someone reacted to a post you wrote.
  reaction
  /// Someone reacted to your comment or reply.
  comment_reaction
  /// A new post was published.
  new_post
  /// Sessions were added, changed or removed (one per burst of edits; scheduleDates lists the days).
  schedule_change
  /// A session's start time has come.
  schedule_reminder
}

/// One row per recipient. Deleting the post, comment, session or recipient removes it.
/// Post notifications carry postId; schedule ones carry scheduleDates or scheduleItemId.
model Notification {
  id             String           @id @default(cuid())
  type           NotificationType
  user           User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  /// Who caused it; kept as null if that account is deleted.
  actor          User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId        String?
  post           Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId         String?
  comment        Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId      String?
  scheduleItem   ScheduleItem?    @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  scheduleItemId String?
  /// Days whose sessions changed ("YYYY-MM-DD", ascending), for schedule_change.
  scheduleDates  String[]         @default([])
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// A browser or installed app (PWA) that receives this user's notifications as phone/desktop popups.
model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// The push service URL; unique per browser install.
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// How often a task's checkmark resets: every day, every Saturday→Friday week, or never.
enum TaskRepeat {
  daily
  weekly
  once
}

/// «مهامي» — a task every member ticks off, set by admins and schedule managers.
model Task {
  id          String           @id @default(cuid())
  title       String
  description String?
  /// Optional link to open from the task (a lecture, a page of the mushaf…).
  linkUrl     String?
  repeat      TaskRepeat       @default(daily)
  order       Int              @default(0)
  /// Archived tasks are hidden from members but keep their history.
  active      Boolean          @default(true)
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  completions TaskCompletion[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([active, order])
}

/// One member ticked one task for one period: the day ("2026-11-14"), the week's
/// Saturday ("2026-11-14"), or "once" for a one-time task.
model TaskCompletion {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  period    String
  createdAt DateTime @default(now())

  @@unique([taskId, userId, period])
  @@index([userId, period])
  @@index([taskId, period])
}
