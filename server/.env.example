# قاعدة البيانات (Neon — https://neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# مفتاح توقيع التوكنات — أنشئ مفتاحاً عشوائياً طويلاً
JWT_SECRET=change-me-to-a-long-random-string

# المنفذ
PORT=4000

# بيئة التشغيل: development | production
NODE_ENV=development

# السحابة للصور (اختياري وقت التطوير، مطلوب في الإنتاج)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# حساب المشرف الأول — يُنشأ فقط إذا لم يوجد أي مشرف (يستخدمه db:seed فقط)
SEED_ADMIN_EMAIL=admin@almagles.app
SEED_ADMIN_PASSWORD=change-me

# كلمة مرور الحسابات التجريبية — db:seed:demo فقط، ويعمل على قاعدة بيانات محلية فقط
SEED_DEMO_PASSWORD=

# مدة صلاحية رمز الدخول بالدقائق (رمز التحديث يجددها تلقائياً)
ACCESS_TTL_MINUTES=15

# البريد عبر Brevo — EMAIL_FROM هو العنوان الموثّق في Brevo (Senders)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=رجال الأمة
# 0 = إرسال فعلي أثناء التطوير، 1 (الافتراضي) = طباعة الرمز في الطرفية
MAIL_DEV_MODE=1
